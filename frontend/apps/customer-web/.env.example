# Per-service base URLs. No api-gateway exists yet, so each service is addressed directly on the
# port its application.yml declares. Copy to .env.local for local development.
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8081
NEXT_PUBLIC_SEARCH_API_URL=http://localhost:8082
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8084
NEXT_PUBLIC_BOOKING_API_URL=http://localhost:8085
NEXT_PUBLIC_PAYMENT_API_URL=http://localhost:8086
